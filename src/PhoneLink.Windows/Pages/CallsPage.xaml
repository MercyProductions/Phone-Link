<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneLink.Windows.Pages.CallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneLink.Windows.Pages"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="32" FontWeight="SemiBold" Text="Calls" />
                <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Top" Click="RefreshButton_Click" Content="Check PBAP" />
            </Grid>
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="The portable public-API path is user-confirmed click-to-call on iPhone. Cellular audio, answer, and hang-up control depend on system Bluetooth support and are not implemented or implied here."
                Severity="Informational"
                Title="Public API boundary" />
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Request a call on iPhone" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="The iPhone will show the exact number and require confirmation before opening the system Phone app."
                        TextWrapping="Wrap" />
                    <Grid MaxWidth="620" HorizontalAlignment="Left" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PhoneNumberBox" PlaceholderText="Phone number" InputScope="TelephoneNumber" />
                        <Button x:Name="CallButton" Grid.Column="1" Click="CallButton_Click" Content="Send to iPhone" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <InfoBar x:Name="CallResultBar" IsClosable="True" IsOpen="False" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" Title="Bluetooth capability check failed" />
            <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Left" />
            <ListView ItemsSource="{x:Bind Capabilities}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AppleBluetoothCapabilityListItem">
                        <Border Margin="0,0,0,8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind Status}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border MinHeight="300" Padding="36" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE717;" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No call activity" />
                    <TextBlock MaxWidth="520" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="PBAP can expose call history on some system pairings; it does not grant Phone Link cellular call control." TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
