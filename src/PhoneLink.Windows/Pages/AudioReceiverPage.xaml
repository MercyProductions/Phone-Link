<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="PhoneLink.Windows.Pages.AudioReceiverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Phone audio → PC" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Receive media audio from a Bluetooth-paired source through Windows' A2DP sink. This is not cellular-call audio, a microphone link, or Apple ecosystem pairing. A USB cable alone does not enable it."
                TextWrapping="Wrap" />
            <Button x:Name="ScanButton" Content="Find audio sources" Click="ScanButton_Click" />
            <ComboBox x:Name="DeviceSelector" Header="Select your own Bluetooth audio source" MinWidth="320" MaxWidth="700" SelectionChanged="DeviceSelector_SelectionChanged" />
            <TextBlock Text="Names are not authenticated identities. Select your own phone. Enabling and opening the connection may immediately play its current audio on PC speakers or headphones; check volume and privacy first. Phone Link does not record the audio or change system volume."
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="OpenButton" Content="Receive selected phone audio" Click="OpenButton_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="StopButton" Content="Stop / release" Click="StopButton_Click" IsEnabled="False" />
            </StackPanel>
            <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock x:Name="StateText" Text="No audio receiver is enabled by this page." TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
            <TextBlock Text="An Opened connection is not proof that samples are arriving or sound is audible. Start playback and verify sound yourself. This page releases its connection when you stop, navigate away, hide the app, or lock it. Other audio receiver apps may still hold connections; stopping here does not stop playback on the phone. One-time reconnect is off unless you opt in when opening the receiver."
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton Content="Microsoft remote Bluetooth audio guide" NavigateUri="https://learn.microsoft.com/en-us/windows/apps/develop/media-playback/enable-remote-audio-playback" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
