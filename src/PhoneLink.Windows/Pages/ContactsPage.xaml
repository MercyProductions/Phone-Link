<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneLink.Windows.Pages.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneLink.Windows.Pages"
    xmlns:bt="using:PhoneLink.Integrations.AppleBluetooth.Capabilities"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="32" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock FontSize="32" FontWeight="SemiBold" Text="Contacts" />
            <TextBlock
                MaxWidth="760"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Contacts authorized in the iPhone companion are synchronized over the authenticated local connection."
                TextWrapping="Wrap" />
        </StackPanel>

        <Expander Grid.Row="1" Header="Bluetooth phone book (read-only)" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" Expanding="BluetoothExpander_Expanding" Collapsed="BluetoothExpander_Collapsed">
            <StackPanel Spacing="8">
                <TextBlock Text="Read names and phone numbers from the selected iPhone if it permits Bluetooth contact sharing. This list is not saved or merged with companion contacts." TextWrapping="Wrap" />
                <ComboBox x:Name="BluetoothPeerBox" Header="Select your paired iPhone" ItemsSource="{x:Bind BluetoothPeers}"
                    DisplayMemberPath="DisplayName" SelectionChanged="BluetoothPeerBox_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BluetoothSizeButton" Content="Check count only" Click="BluetoothSizeButton_Click" IsEnabled="False" />
                    <Button x:Name="BluetoothReadButton" Content="Read phone book" Click="BluetoothReadButton_Click" IsEnabled="False" />
                    <Button x:Name="BluetoothPreviousButton" Content="Previous page" Click="BluetoothPreviousButton_Click" IsEnabled="False" />
                    <Button x:Name="BluetoothNextButton" Content="Next page" Click="BluetoothNextButton_Click" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="BluetoothSizeStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="BluetoothStatus" Text="No contacts requested." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ListView ItemsSource="{x:Bind BluetoothContacts}" SelectionMode="None" MaxHeight="210">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="bt:BluetoothContactPreview">
                            <StackPanel Spacing="3" Padding="0,5">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind NumbersText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Expander>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="2"
            MaxWidth="620"
            HorizontalAlignment="Left"
            PlaceholderText="Search contact names"
            TextChanged="SearchBox_TextChanged" />

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="Contacts could not be loaded" />

        <Grid Grid.Row="4">
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <Border
                x:Name="EmptyState"
                MaxWidth="820"
                MinHeight="300"
                HorizontalAlignment="Stretch"
                Padding="36"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE77B;" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No synchronized contacts" />
                    <TextBlock
                        MaxWidth="420"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Connect the iPhone companion, open Sync, and choose Synchronize contacts."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ListView
                x:Name="ContactsList"
                ItemsSource="{x:Bind Contacts}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ContactListItem">
                        <Grid Padding="10,8" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="20">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Initials}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Detail}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
