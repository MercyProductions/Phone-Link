<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneLink.Windows.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneLink.Windows.Pages"
    xmlns:bt="using:PhoneLink.Integrations.AppleBluetooth.Capabilities"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Messages" />
                </Grid>
                <TextBox Grid.Row="1" IsEnabled="False" PlaceholderText="Search conversations" />
                <Button
                    x:Name="RefreshButton"
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Click="RefreshButton_Click"
                    Content="Check Bluetooth MAP" />
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon HorizontalAlignment="Center" FontSize="38" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8BD;" />
                    <TextBlock FontWeight="SemiBold" Text="Read-only Bluetooth inbox" />
                    <TextBlock
                        MaxWidth="230"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Only the inbox previews the selected Bluetooth device permits can appear here. USB and pairing alone do not grant Messages access."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="24,18" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Message capability" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Live results from Windows Bluetooth discovery; no capability is assumed from pairing alone." />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="24" Spacing="16">
                    <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" Title="Bluetooth capability check failed" />
                    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Left" />
                    <ComboBox x:Name="PeerBox" Header="Select your paired iPhone" ItemsSource="{x:Bind Peers}"
                        DisplayMemberPath="DisplayName" SelectionChanged="PeerBox_SelectionChanged" HorizontalAlignment="Left" />
                    <Button x:Name="ReadInboxButton" Content="Read permitted inbox previews" Click="ReadInboxButton_Click" IsEnabled="False" />
                    <TextBlock x:Name="InboxStatus" Text="No messages requested." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl ItemsSource="{x:Bind Inbox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="bt:MapInboxItem">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="{x:Bind Sender}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Type}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ListView ItemsSource="{x:Bind Capabilities}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AppleBluetoothCapabilityListItem">
                                <Border Margin="0,0,0,8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind Status}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        MaxWidth="640"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Service discovery does not prove that inbox reads or sending are permitted. This tab does not access the iPhone Messages database, send messages, or save previews."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Margin="24" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button IsEnabled="False"><FontIcon Glyph="&#xE898;" /></Button>
                    <TextBox Grid.Column="1" IsEnabled="False" PlaceholderText="Select an available message source first" />
                    <Button Grid.Column="2" Content="Send" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
