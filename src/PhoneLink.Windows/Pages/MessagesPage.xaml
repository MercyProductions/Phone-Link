<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneLink.Windows.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneLink.Windows.Pages"
    xmlns:bt="using:PhoneLink.Integrations.AppleBluetooth.Capabilities"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Messages" />
                </Grid>
                <TextBox Grid.Row="1" IsEnabled="False" PlaceholderText="Search conversations" />
                <Button
                    x:Name="RefreshButton"
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Click="RefreshButton_Click"
                    Content="Check Bluetooth MAP" />
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon HorizontalAlignment="Center" FontSize="38" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8BD;" />
                    <TextBlock FontWeight="SemiBold" Text="Read-only Bluetooth inbox" />
                    <TextBlock
                        MaxWidth="230"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Only the inbox previews the selected Bluetooth device permits can appear here. USB and pairing alone do not grant Messages access."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="24,18" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Message capability" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Live results from Windows Bluetooth discovery; no capability is assumed from pairing alone." />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="24" Spacing="16">
                    <Expander Header="Draft a message for iPhone" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="This uses the paired Phone Link companion, not the Bluetooth inbox. Review and tap Send in Apple’s composer on your iPhone. Nothing is sent automatically or saved by Phone Link. Leaving this page stops waiting; cancel a draft already visible on the iPhone there." TextWrapping="Wrap" />
                            <Button x:Name="RefreshDraftTargetsButton" Content="Find connected iPhones" Click="RefreshDraftTargetsButton_Click" />
                            <ComboBox x:Name="DraftTargetBox" Header="Select an authenticated iPhone"
                                DisplayMemberPath="SelectionLabel" SelectionChanged="DraftTargetBox_SelectionChanged" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="DraftNumberBox" Header="Recipient phone number" MaxLength="64" InputScope="TelephoneNumber" />
                            <TextBox x:Name="DraftBodyBox" Header="Draft text (up to 1,000 UTF-8 bytes)" MaxLength="1000"
                                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                            <Button x:Name="ReviewDraftButton" Content="Review draft on iPhone" Click="ReviewDraftButton_Click" IsEnabled="False" />
                            <TextBlock x:Name="DraftStatus" Text="Open the updated iPhone companion, then find connected iPhones." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Expander>
                    <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" Title="Bluetooth capability check failed" />
                    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Left" />
                    <ComboBox x:Name="PeerBox" Header="Select your paired iPhone" ItemsSource="{x:Bind Peers}"
                        DisplayMemberPath="DisplayName" SelectionChanged="PeerBox_SelectionChanged" HorizontalAlignment="Left" />
                    <Button x:Name="ReadInboxButton" Content="Read permitted inbox previews" Click="ReadInboxButton_Click" IsEnabled="False" />
                    <TextBlock x:Name="InboxStatus" Text="No messages requested." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl ItemsSource="{x:Bind Inbox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="bt:MapInboxItem">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="{x:Bind Sender}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Type}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ListView ItemsSource="{x:Bind Capabilities}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AppleBluetoothCapabilityListItem">
                                <Border Margin="0,0,0,8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind Status}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        MaxWidth="640"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Bluetooth service discovery does not prove inbox access. This Bluetooth path does not access the iPhone Messages database, send messages, or save previews."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
