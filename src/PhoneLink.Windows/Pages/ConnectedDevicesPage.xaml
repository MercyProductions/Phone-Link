<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneLink.Windows.Pages.ConnectedDevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="32" FontWeight="SemiBold" Text="Connected devices" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Manage trusted computers and iPhones." />
                </StackPanel>
                <Button
                    x:Name="PairButton"
                    Grid.Column="1"
                    Click="PairButton_Click"
                    Content="Pair iPhone"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Nearby services" />
                        <Button x:Name="DiscoverButton" Grid.Column="1" Content="Refresh" Click="DiscoverButton_Click" />
                    </Grid>
                    <TextBlock Text="Local service advertisements help you find devices. Identity is verified separately through secure pairing." TextWrapping="Wrap" />
                    <TextBlock x:Name="DiscoverySummary" Text="Looking for nearby services…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="NearbyServicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6" Spacing="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Local connections" />
                    <TextBlock Text="Your PC's network addresses update automatically. Pair your iPhone on the same local network to verify its identity." TextWrapping="Wrap" />
                    <TextBlock x:Name="NetworkSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ItemsControl x:Name="NetworksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border
                x:Name="PairingPanel"
                Padding="28"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="Collapsed">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12" Background="White" CornerRadius="12">
                        <Image x:Name="QrImage" Width="320" Height="320" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" MaxWidth="520" VerticalAlignment="Center" Spacing="12">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Scan inside the iPhone companion" />
                        <TextBlock
                            Text="Install this project's Phone Link companion on your iPhone first. Open it, choose Pair with Windows, then Scan QR code. Keep both devices on the same Wi-Fi network."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="If Apple Camera says ‘No usable data found’, use the scanner inside the companion. This code is not an app-download link and does not pair through Microsoft Phone Link."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ExpiryText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="Compare the six words on both screens before approving. Never scan a code sent by another person."
                            Severity="Informational" />
                        <Button HorizontalAlignment="Left" Click="CancelPairing_Click" Content="Cancel pairing" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Trusted devices" />
            <ListView x:Name="DevicesList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="72" Padding="12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="28" Glyph="&#xE8EA;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding ConnectionStatus}" />
                            <Button
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="RevokeButton_Click"
                                CommandParameter="{Binding DeviceId}"
                                Content="Revoke"
                                IsEnabled="{Binding CanRevoke}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="EmptyState" MinHeight="220" Padding="36" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE968;" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No trusted devices" />
                    <TextBlock
                        MaxWidth="520"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pair your iPhone to establish authenticated local sync. Phone Link never asks for your Apple Account password."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
