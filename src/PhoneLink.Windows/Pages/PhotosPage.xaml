<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneLink.Windows.Pages.PhotosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneLink.Windows.Pages"
    Loaded="Page_Loaded">
    <Grid Padding="32" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock FontSize="32" FontWeight="SemiBold" Text="Imported photos" />
            <TextBlock
                MaxWidth="760"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Photos explicitly selected in the iPhone system picker appear here after integrity verification. Files remain encrypted in Phone Link storage."
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="Photos could not be loaded" />

        <Grid Grid.Row="2">
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEB9F;" />
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="No imported photos" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="On iPhone, open Sync and choose photos to import."
                    TextAlignment="Center" />
            </StackPanel>

            <ListView
                x:Name="PhotosList"
                ItemsSource="{x:Bind Photos}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ImportedPhotoListItem">
                        <Grid Padding="12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="8">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xEB9F;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="12">
                                <TextBlock FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="Verified" />
                            </Border>
                            <Button
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="SaveCopyButton_Click"
                                CommandParameter="{x:Bind AttachmentId}"
                                Content="Save a copy" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
