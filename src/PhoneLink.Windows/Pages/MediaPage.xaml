<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="PhoneLink.Windows.Pages.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneLink.Windows.Pages"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="16">
            <TextBlock Text="iPhone media" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Apple Media Service accessory controls for a paired device you own. This controls the phone's active player; it does not stream audio to Windows or require the companion. Service discovery alone does not prove access."
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ScanButton" Content="Scan paired devices" Click="ScanButton_Click" />
                <Button x:Name="StartButton" Content="Start selected session" Click="StartButton_Click" IsEnabled="False" />
                <Button x:Name="StopButton" Content="Stop / cancel" Click="StopButton_Click" IsEnabled="False" />
                <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
            </StackPanel>
            <ComboBox x:Name="DeviceSelector" Header="Select your paired phone explicitly" DisplayMemberPath="DisplayName"
                HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed" />
            <CheckBox x:Name="ReconnectBox" IsEnabled="False" IsChecked="False"
                AutomationProperties.Name="Reconnect once after Bluetooth disconnects">
                <TextBlock Text="After this session opens, try reconnecting to this same phone once if Bluetooth disconnects. Restores subscriptions only; does not replay commands." TextWrapping="Wrap" />
            </CheckBox>
            <Button x:Name="DeliveryCheckButton" Content="Check media data delivery" Click="DeliveryCheckButton_Click" IsEnabled="False" />
            <TextBlock Text="A short check using existing access only. Requests a playback-state update and reports whether it arrived, without displaying its value, reading track titles, or sending playback commands."
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Remote controls" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionText" Text="No session. Scan and select your phone to begin." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviousButton" Content="Previous" Click="QuickCommand_Click" IsEnabled="False" />
                        <Button x:Name="PlayButton" Content="Play" Click="QuickCommand_Click" IsEnabled="False" />
                        <Button x:Name="PauseButton" Content="Pause" Click="QuickCommand_Click" IsEnabled="False" />
                        <Button x:Name="NextButton" Content="Next" Click="QuickCommand_Click" IsEnabled="False" />
                    </StackPanel>
                    <ComboBox x:Name="CommandSelector" Header="Commands currently advertised by the player" DisplayMemberPath="Label"
                        HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed" />
                    <Button x:Name="SendButton" Content="Review and send command" Click="SendButton_Click" IsEnabled="False" />
                    <TextBlock Text="Shortcuts are enabled only for commands currently advertised by the selected phone. Every command needs confirmation. An accepted write does not prove the player acted. Playback commands are never retried automatically. The session stops on navigation away, Phone Link lock, or Stop."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Now playing · reported by iPhone" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="NowPlayingText" Text="No track metadata received." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Text="Latest player, queue and track observations" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Fields arrive independently, not as an atomic now-playing snapshot. Select a truncated field to request its full value if the phone exposes that option. Data stays in memory and is cleared when the session ends."
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ExpandButton" Content="Read full selected value" IsEnabled="False" Click="ExpandButton_Click" />
            <ListView x:Name="ObservationList" ItemsSource="{x:Bind Observations}" SelectionMode="Single" SelectionChanged="Selection_Changed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MediaObservationRow">
                        <Border Padding="16" Margin="0,0,0,8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
